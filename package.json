{
  "name": "dsh-nexscope",
  "version": "0.1.0",
  "description": "Nexscope ecommerce research for DeepSeek Harness: OAuth sign-in, the full published capability catalog, exports, and account queries.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0",
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "nexscope",
    "ecommerce",
    "amazon",
    "tiktok",
    "mcp",
    "oauth"
  ],
  "author": "Nexscope",
  "homepage": "https://www.nexscope.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexscope-ai/dsh-nexscope-plugin.git"
  },
  "license": "LicenseRef-Proprietary",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials-local": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "bugs": {
    "url": "https://github.com/nexscope-ai/dsh-nexscope-plugin/issues"
  }
}
